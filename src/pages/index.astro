---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Lindsey King</div>
    <div class="text-3xl py-3 font-bold">Instructional Designer | eLearning Developer</div>
    <div class="py-2">
      <text class="text-lg">
        I design scenario‑based learning that helps people make better decisions in the moments that matter.
      </text>
    </div>
    <div class="mt-8">
      <a href="/contact" class="btn btn-outline ml-5">Let's Connect</a>
      <a href="/resume.pdf" class="btn btn-outline ml-5">My Resume</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My Projects</div>
  </div>

  <HorizontalCard
    title="Colorado Mandatory Reporting for Online Student Interactions"
    img="/postfire/pwfdf-map-2.png"
    desc="I'm building a scenario-based e‑learning module to help Colorado educators recognize concerning student behaviors in virtual environments and make confident, legally aligned reporting decisions."
    url="/postfire-debris-flows"
    badge="Under Construction"
  />

  <div class="divider my-0"></div>

  <HorizontalCard
    title="The Feedback Conversation"
    img="/da/sam.png"
    desc="I’m building a branching scenario that helps managers navigate tough feedback conversations with clarity, empathy, and psychological safety. Learners practice real‑world dialogue choices and see the impact of their decisions."
    url="/climate-data-assimilation"
    badge="Under Construction"
  />

  <HorizontalCard
    title="Your Quick Response Guide to Bat Home Invasion"
    img="/da/sam.png"
    desc="I created this microlearning to teach Colorado homeowners a simple, safe, and humane five‑step response when a bat enters their home, reinforced through a short scenario and mobile‑friendly guidance."
    url="/climate-data-assimilation"
    
  />

</BaseLayout>
