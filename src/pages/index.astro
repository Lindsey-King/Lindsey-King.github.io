---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Lindsey King</div>
    <div class="text-3xl py-3 font-bold">Instructional Designer | eLearning Developer</div>
    <div class="py-2">
      <text class="text-lg">
        I design scenario‑based learning that helps people make better decisions in the moments that matter.
      </text>
    </div>
    <div class="mt-8">
      <a href="/contact" class="btn btn-outline ml-5">Let's Connect</a>
      <a href="/resume.pdf" class="btn btn-outline ml-5">My Resume</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My Projects</div>
  </div>

  <HorizontalCard
    title="Colorado Mandatory Reporting for Online Student Interactions"
    img="/postfire/pwfdf-map-2.png"
    desc="A scenario-based Articulate Storyline 360 E-Learning Module"
    url="/postfire-debris-flows"
    badge="Under Construction"
  />

  <div class="divider my-0"></div>

  <HorizontalCard
    title="The Feedback Conversation"
    img="/da/sam.png"
    desc="A branching scenario training for managers"
    url="/climate-data-assimilation"
    badge="Under Construction"
  />

  <HorizontalCard
    title="Your Quick Response Guide to Bat Home Invasion"
    img="/da/sam.png"
    desc="An Articulate Rise 360 Micro E-Learning Course"
    url="/climate-data-assimilation"
    
  />

</BaseLayout>
