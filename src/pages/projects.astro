---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Instructional Design Projects" sideBarActiveItemID="pfdfs">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Instructional Design Projects</div>
  </div>

  <div class="py-2 mb-6">
      <text class="text-lg prose">
      I design learning experiences that turn real‑world uncertainty into confident action. My work blends clear, human‑centered content with scenario‑based practice, helping learners make better decisions in the moments that matter. Whether I’m building microlearning, compliance training, or judgment‑focused scenarios, my approach stays consistent: simplify the complex, reduce cognitive load, and create clean, modern experiences that people can actually use.
  </div>


  <HorizontalCard
    title="Colorado Mandatory Reporting for Online Student Interactions"
    img="/postfire/pwfdf-map-2.png"
    desc="A scenario-based Articulate Storyline 360 E-Learning Module"
    url="/postfire-debris-flows/pwfdf"
    badge="Under Construction"
  /> 

  <div class="divider my-0"></div>

  <HorizontalCard
    title="The Feedback Conversation"
    img="/postfire/pwfdf-api.png"
    desc="A branching scenario training for managers"
    url="/postfire-debris-flows/pwfdf-api"
    badge="Under Construction"
  /> 

  <div class="divider my-0"></div>

  <HorizontalCard
    title="Your Quick Response Guide to Bat Home Invasions"
    img="/postfire/ocelote.png"
